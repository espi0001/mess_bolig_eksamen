RewriteEngine On # Tænder Apache’s rewrite-engine, så URL’er kan omskrives


RewriteRule ^$      /pages/page-index.php    [NC,L] # går til page-index direkte


# generic extensionless PHP routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [NC,L] # laver friendly URL


ErrorDocument 404 pages/page-404.php # If page is not found, will redirect to 404.php


RewriteCond %{REQUEST_FILENAME} !-f # Tjekker om den ønskede fil ikke allerede findes fysisk på serveren

RewriteCond %{REQUEST_URI}  !(\.png|\.jpg|\.webp|\.gif|\.jpeg|\.zip|\.css|\.svg|\.js|\.pdf)$ # Tjekker om den ønskede fil er en billede, video, etc. og kan ikke blive omskrevet